# The settings of the DEPLOYED service. In Azure Container Apps these are environment variables (secrets as secretref:). Never commit real values.
# Lines that say REPLACE are secrets: put them in Azure secrets, not in this file.

# --- where it listens (inside the container; the platform puts https in front)
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8080

# --- who may call it: name:scopes:key, comma separated. Make a key with:  python -m security_service.api --new-key
# Scopes: scan (scan), fix (ask for corrections and verifications), read (fetch results). Flwn's backend gets ONE key; users never see it.
SERVICE_API_KEYS=flwn-ai:scan+fix+read:REPLACE_WITH_A_GENERATED_KEY

# --- Azure AI Foundry: Decision-1 (classifier) and GPT-6 Astra (corrector) share one endpoint and key
FOUNDRY_ENDPOINT=https://aif-flwn-fc-01.services.ai.azure.com
FOUNDRY_API_KEY=REPLACE_WITH_THE_FOUNDRY_KEY
DECISION1_DEPLOYMENT=decision-1
CORRECTOR_DEPLOYMENT=gpt-6-astra

# --- Decision-1: ON, for the languages it has passed a held-out test for (today: python). Other languages are covered by the rules alone.
# Add javascript here only after: python -m benchmark.classifier_eval --language javascript --heldout   says PASS.
CLASSIFIER_ENABLED=true
CLASSIFIER_LANGUAGES=python

# --- corrections: ON. Phylax never writes a file: a person approves every correction in the client before anything is applied.
# Each correction is a paid model call, so it has its own, stricter limits.
SERVICE_FIXES_ENABLED=true
SERVICE_FIX_WORKERS=2
SERVICE_FIX_RATE_LIMIT_PER_MINUTE=10

# --- limits and memory
SERVICE_RATE_LIMIT_PER_MINUTE=120
SERVICE_RETENTION_HOURS=24
SERVICE_MAX_WAIT_SECONDS=30
