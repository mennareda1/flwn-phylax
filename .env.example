# Create your private .env from this template, ONCE:    python -m security_service.config --init
# (Never copy the template over .env by hand: a copy silently overwrites a filled-in file.)
#
# .env is private and git-ignored. NEVER commit it, paste it into a chat, or screenshot it.
# Variables set in your terminal (for example $env:FOUNDRY_API_KEY = "...") override this file.
# Check your settings, with no network call, using:    python -m security_service.config

# ---- Your Azure AI Foundry resource -------------------------------------------------------------
# The resource endpoint from the deployment details page. The full
# .../providers/microsoft/v1/systemone URL also works: the path is removed automatically.
FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com

# Your API key. Leave it empty if you sign in with Microsoft Entra ID (DECISION1_AUTH=entra below).
FOUNDRY_API_KEY=

# ---- Microsoft-Decision-1 ------------------------------------------------------------------------
# The deployment name YOU chose in Foundry (shown on the deployment details page).
# It is NOT "Microsoft-Decision-1" unless you kept the portal's default name.
DECISION1_DEPLOYMENT=decision-1

# The model version chosen at deployment time (Microsoft lists version 1).
DECISION1_MODEL_VERSION=1

# key   = send FOUNDRY_API_KEY as an api-key header (default)
# entra = sign in with Microsoft Entra ID instead: run `az login` and `pip install azure-identity`
DECISION1_AUTH=key

# Optional: a separate endpoint or key for Decision-1 only (otherwise the two above are used).
# DECISION1_ENDPOINT=
# DECISION1_API_KEY=

# Optional: seconds to wait per attempt, and how many attempts on temporary errors (429, 5xx, network).
# DECISION1_TIMEOUT=20
# DECISION1_MAX_ATTEMPTS=3

# ---- Decision-1 inside real scans (optional) -------------------------------------------------------
# false = scans use the rules only (the default). true = every Python file is also sent, masked, to
# Decision-1, and its answers are added to the report as "model suspicion" findings. They ask for human
# review; they never block, because a model alone never blocks.
CLASSIFIER_ENABLED=false
# false = if Decision-1 is down, scans still finish on the rules and the report says so (the default).
# true  = if Decision-1 is down, a scan that would have passed becomes scan_failed (human review).
# CLASSIFIER_REQUIRED=false
# The probability at or above which a category becomes a finding. 0.70 is the value the held-out test validated.
# CLASSIFIER_THRESHOLD=0.70

# ---- The corrector, GPT-6 Astra (optional until the fix feature is switched on) ------------------------------
# The exact Name of the Astra deployment: Foundry portal, Deployments, the Name column (often gpt-6-astra).
# It is NOT the model's display name, and it has no spaces.
# CORRECTOR_DEPLOYMENT=gpt-6-astra
# Astra normally lives in the same Foundry resource as Decision-1, so it shares FOUNDRY_ENDPOINT and FOUNDRY_API_KEY.
# Only set these two if Astra is in a different resource:
# CORRECTOR_ENDPOINT=https://YOUR-OTHER-RESOURCE.services.ai.azure.com
# CORRECTOR_API_KEY=
# Which route to call: openai_v1 (the default) or inference. Run  python -m tests.live_corrector  to find the one that works.
# CORRECTOR_API=openai_v1
# Cost controls. Astra bills its thinking as output (50 US dollars per million tokens). Effort is low, medium, high or xhigh.
# CORRECTOR_REASONING_EFFORT=low
# CORRECTOR_MAX_OUTPUT_TOKENS=8000
# CORRECTOR_TIMEOUT_SECONDS=180

# ---- The HTTP service: python -m security_service.api -------------------------------------------------
# Who may call it. One entry per caller, written name:scopes:key and separated by commas. The scopes are scan,
# fix and read, joined with +. Make a key with:  python -m security_service.api --new-key
# A key shorter than 24 characters is refused. The service will not start without at least one.
# SERVICE_API_KEYS=flwn-ai:scan+fix+read:PASTE-A-GENERATED-KEY-HERE
# 127.0.0.1 means only this computer can connect (the default). Use 0.0.0.0 only behind something that provides HTTPS.
# SERVICE_HOST=127.0.0.1
# SERVICE_PORT=8080
# How many hours submitted code and results are kept (in memory only), how many scans run at once, how many
# requests per minute one caller may make, and the longest a request may ask the service to wait for a result.
# SERVICE_RETENTION_HOURS=24
# SERVICE_WORKERS=4
# SERVICE_RATE_LIMIT_PER_MINUTE=120
# SERVICE_MAX_WAIT_SECONDS=30

# ---- Scan limits (optional) ------------------------------------------------------------------------
# SCAN_MAX_FILES=50
# SCAN_MAX_FILE_BYTES=200000
# SCAN_MAX_TOTAL_BYTES=1000000

# ---- Use a .env file from somewhere else (optional) ----------------------------------------------
# SECURITY_ENV_FILE=C:\path\to\my.env
